# Zernio (Instagram & Multi-channel API)
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Tenant identity — required together for shared Supabase deployments
# Never commit real values. BOT_ID must match the tenant key claim.
BOT_ID=
SUPABASE_TENANT_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=


# Optional: Local Bot API base for files >50MB (e.g. http://127.0.0.1:8081)
# TELEGRAM_API_BASE=https://api.telegram.org

# Delivery tuning
# DELIVERY_BATCH_SIZE=8
# DELIVERY_MAX_FILE_MB=100

# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client / Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# App URL (used for product images in Telegram)
PUBLIC_APP_URL=https://your-project.vercel.app

# Admin authentication (server-side only)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Admin session (set a long random string in production)
SESSION_SECRET=

# Vercel Cron / self-heal webhook (random string; same value in cron-job.org)
CRON_SECRET=

# Optional: Telegram webhook secret_token (if set, must match setWebhook)
TELEGRAM_WEBHOOK_SECRET=

# Optional: Google Cloud Vision API key — OCR check for auto-delivery receipts (±10% amount)
# Without it, receipt auto-delivery falls back to manual admin confirmation.
# GOOGLE_VISION_API_KEY=


